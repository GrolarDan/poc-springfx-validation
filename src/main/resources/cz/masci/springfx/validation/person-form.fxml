<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.RowConstraints?>

<GridPane hgap="10" vgap="4"
          stylesheets="@person-form.css"
          xmlns="http://javafx.com/javafx"
          xmlns:fx="http://javafx.com/fxml"
          fx:controller="cz.masci.springfx.validation.controller.PersonFormController">

    <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>

    <columnConstraints>
        <ColumnConstraints minWidth="100" prefWidth="120"/>
        <ColumnConstraints minWidth="200" prefWidth="260" hgrow="ALWAYS"/>
    </columnConstraints>

    <!-- row heights will grow with content -->
    <rowConstraints>
        <RowConstraints/>   <!-- name label -->
        <RowConstraints/>   <!-- name field -->
        <RowConstraints/>   <!-- name error -->
        <RowConstraints/>   <!-- age label -->
        <RowConstraints/>   <!-- age field -->
        <RowConstraints/>   <!-- age error -->
        <RowConstraints/>   <!-- gender label -->
        <RowConstraints/>   <!-- gender field -->
        <RowConstraints/>   <!-- gender error -->
        <RowConstraints/>   <!-- save button -->
    </rowConstraints>

    <!-- Name -->
    <Label text="Name:" GridPane.rowIndex="0" GridPane.columnIndex="0" GridPane.columnSpan="2"/>
    <TextField fx:id="nameField" GridPane.rowIndex="1" GridPane.columnIndex="0" GridPane.columnSpan="2" maxWidth="Infinity"/>
    <Label fx:id="nameError" text="" styleClass="error-label"
           GridPane.rowIndex="2" GridPane.columnIndex="0" GridPane.columnSpan="2"/>

    <!-- Age -->
    <Label text="Age:" GridPane.rowIndex="3" GridPane.columnIndex="0" GridPane.columnSpan="2"/>
    <TextField fx:id="ageField" GridPane.rowIndex="4" GridPane.columnIndex="0" GridPane.columnSpan="2" maxWidth="Infinity"/>
    <Label fx:id="ageError" text="" styleClass="error-label"
           GridPane.rowIndex="5" GridPane.columnIndex="0" GridPane.columnSpan="2"/>

    <!-- Gender -->
    <Label text="Gender:" GridPane.rowIndex="6" GridPane.columnIndex="0" GridPane.columnSpan="2"/>
    <ComboBox fx:id="genderComboBox" maxWidth="Infinity"
              GridPane.rowIndex="7" GridPane.columnIndex="0" GridPane.columnSpan="2"/>
    <Label fx:id="genderError" text="" styleClass="error-label"
           GridPane.rowIndex="8" GridPane.columnIndex="0" GridPane.columnSpan="2"/>

    <!-- Save button -->
    <Button fx:id="saveButton" text="Save" onAction="#onSave"
            GridPane.rowIndex="9" GridPane.columnIndex="1"
            GridPane.halignment="RIGHT"/>

</GridPane>
